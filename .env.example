# ============================================================
#  ticker-alerts configuration
#  Copy this file to ".env" and fill in the values.
#  Anything you leave alone uses the default shown.
# ============================================================

# --- REQUIRED: Telegram ------------------------------------
# 1. In Telegram, message @BotFather -> /newbot -> follow prompts.
#    He gives you a token that looks like 123456789:AAE...
TELEGRAM_BOT_TOKEN=

# 2. Message @userinfobot in Telegram. It replies with your numeric Id.
#    Put that number here. Only these chat IDs can control the bot
#    and receive alerts. Comma-separate for multiple.
TELEGRAM_CHAT_IDS=

# --- REQUIRED: SEC contact string --------------------------
# The SEC requires every automated request to identify itself with a
# real name and email. They will throttle/block you without it.
# Format: "Your Name your@email.com"
SEC_USER_AGENT=Trenton Dragon trentondragon02@gmail.com

# --- Alpaca (free account, used for real-time news + movers) -
# Sign up free at https://alpaca.markets (a PAPER account is enough,
# no funding required). Then Home -> "Generate API Keys".
# If you leave these blank the system still runs: SEC filings and RSS
# news keep working, you just lose the fast news stream + movers scan.
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Alert window (Eastern Time, 24h clock) ----------------
ALERT_START_HOUR=4
ALERT_END_HOUR=20
# Send alerts on Saturday/Sunday too? Filings are rare but not impossible.
ALERT_WEEKENDS=true

# --- Polling intervals (seconds) ---------------------------
# Lower = faster alerts + more requests. These are already tuned to sit
# comfortably inside the SEC's published rate limit. Don't go below 5.
SEC_GLOBAL_POLL_SEC=8
SEC_FORM_POLL_SEC=15
SEC_SUBMISSIONS_POLL_SEC=30

# Alert on offering filings from companies NOT on your watchlist?
# Leave this false. Measured volume: 424B2 alone is ~230 filings/hour, almost
# all of them bank structured notes. Turning this on produces hundreds of
# irrelevant alerts a day and trains you to ignore the ones that matter.
SEC_WIDE_NET=false
RSS_POLL_SEC=45
MOVERS_POLL_SEC=300

# --- Auto-discovered movers --------------------------------
MOVERS_ENABLED=true
# How many of the day's top movers to auto-watch at a time.
MOVERS_MAX_TICKERS=25
# Only auto-watch names inside this price band (typical day-trade range).
MOVERS_MIN_PRICE=0.40
MOVERS_MAX_PRICE=60.0
# Minimum % move and minimum share volume to qualify.
MOVERS_MIN_PCT=6.0
MOVERS_MIN_VOLUME=400000

# --- Noise control -----------------------------------------
# General NASDAQ / AI sector headlines (not tied to your tickers).
SECTOR_NEWS_ENABLED=true
# Comma-separated Google News search terms for sector coverage.
SECTOR_NEWS_QUERIES=NASDAQ AI stocks,artificial intelligence chip stocks,AI semiconductor news,small cap tech offering

# Drop syndicated opinion columns ("Should You Buy X?", "3 Reasons...",
# Motley Fool / Zacks commentary). These are never events, and on a busy
# ticker they outnumber real headlines. Set false to let everything through.
FILTER_OPINION=true

# Suppress a repeat alert for the same ticker+headline within N seconds.
DEDUPE_WINDOW_SEC=86400

# --- Health monitoring -------------------------------------
# If a data source goes silent this long during market hours, warn you.
WATCHDOG_STALE_SEC=420
# Daily "system is alive" summary, Eastern time hour (24h). -1 disables.
DAILY_SUMMARY_HOUR=20

# --- Misc ---------------------------------------------------
DB_PATH=/app/data/alerts.db
LOG_LEVEL=INFO
HEALTH_PORT=8080
